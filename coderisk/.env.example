CODERISK_BACKEND_PORT=8080
CODERISK_ANALYSIS_PORT=8001
CODERISK_FRONTEND_PORT=5173
# Startup scripts derive absolute storage paths from the clone directory.
# Override CODERISK_UPLOAD_DIR / CODERISK_ARTIFACT_DIR only when needed.
CODERISK_ANALYSIS_BASE_URL=http://localhost:8001
CODERISK_ANALYSIS_TIMEOUT_SECONDS=60
SPRING_PROFILES_ACTIVE=local
CODERISK_LOCAL_DB_URL=jdbc:h2:file:../data/db/coderisk-local;MODE=MySQL;DATABASE_TO_LOWER=TRUE;CASE_INSENSITIVE_IDENTIFIERS=TRUE;AUTO_SERVER=TRUE

# Used by the mysql Spring profile. The local profile uses persistent H2 instead.
CODERISK_DB_URL=jdbc:mysql://127.0.0.1:3306/coderisk?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
CODERISK_DB_USERNAME=coderisk
CODERISK_DB_PASSWORD=coderisk

MYSQL_ROOT_PASSWORD=coderisk_root
MYSQL_DATABASE=coderisk
MYSQL_USER=coderisk
MYSQL_PASSWORD=coderisk
REDIS_PORT=6379
