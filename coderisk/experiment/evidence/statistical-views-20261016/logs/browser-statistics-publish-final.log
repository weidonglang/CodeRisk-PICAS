        check(!(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1)),'NO_PAGE_OVERFLOW_'+width+'_'+key);
        check(await chart(key).locator('.chart-surface').evaluate(el=>el.clientWidth>0&&el.clientHeight>0),'RESIZED_NONZERO_'+width+'_'+key);
      }
      check(await page.locator('.project-credit').isVisible(),'COPYRIGHT_VISIBLE_'+width);
    }
    await page.setViewportSize({width:1440,height:1000});
    allMissing=true;
    await page.reload();await page.getByText('分析',{exact:true}).click();
    await page.getByText('分数分布',{exact:true}).click();
    await page.getByText('没有有效综合分，未绘制分布',{exact:true}).waitFor();
    check(await page.locator('.stat-chart').count()===0,'ALL_MISSING_HAS_NO_INVENTED_HISTOGRAM');
    await page.getByText('规范化对照',{exact:true}).click();
    await page.getByText('没有共同有效的 Raw / Canonical，未绘制散点',{exact:true}).waitFor();
    check(await page.locator('.stat-chart').count()===0,'ALL_MISSING_HAS_NO_INVENTED_SCATTER');
    await page.getByText('多维结构',{exact:true}).click();
    await page.getByText('各分量有效值不足4个，暂不绘制箱线图',{exact:true}).waitFor();
    check(await page.locator('.stat-chart').count()===0,'ALL_MISSING_HAS_NO_INVENTED_HEATMAP_OR_BOX');
    check(errors.length===0,'NO_BROWSER_RUNTIME_ERRORS');
    check(!requests.some(url=>/^https?:/.test(url)&&!url.startsWith(origin+'/')&&!/^https?:\/\/[^/]*\.kaspersky-labs\.com\//.test(url)),'NO_EXTERNAL_APP_REQUESTS_EXCLUDING_ENVIRONMENT_ANTIVIRUS');
    check((await page.locator('.project-credit').innerText()).includes('魏语石'),'COPYRIGHT_HOLDER_TEXT');
  } finally {
    await page.unroute(origin+'/api/tasks/9920**');await page.unroute(origin+'/api/results/992**');
    page.off('pageerror',onError);page.off('request',onRequest);
    await page.setViewportSize({width:1440,height:1000});await page.goto(origin+'/dashboard');
  }
  return {kind:'BROWSER_INTERCEPTED_FIXED_UI_FIXTURES_ONLY',checks,errors,databaseWrites:0,mockRoutesRemoved:true,environmentAntivirusRequests:requests.filter(url=>/^https?:\/\/[^/]*\.kaspersky-labs\.com\//.test(url)).length};
