  "required": [
    "sample_id",
    "problem_id",
    "source_family_id",
    "generation_session_id",
    "origin_type",
    "ai_assistance_type",
    "parent_sample_id",
    "code_path",
    "language",
    "code_sha256",
    "syntax_status",
    "functional_check_status",
    "functional_check_evidence",
    "raw_output_ref",
    "license_or_authorization_ref",
    "redistribution_allowed",
    "privacy_status",
    "synthetic",
    "split"
