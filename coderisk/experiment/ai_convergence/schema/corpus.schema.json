{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Sample Id",
          "type": "string"
        },
        "problem_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Problem Id",
          "type": "string"
        },
        "source_family_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Source Family Id",
          "type": "string"
        },
        "generation_session_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generation Session Id"
        },
        "origin_type": {
          "enum": [
            "HUMAN",
            "AI",
            "UNKNOWN"
          ],
          "title": "Origin Type",
          "type": "string"
        },
        "ai_assistance_type": {
          "enum": [
            "HUMAN_ONLY",
            "PURE_AI",
            "AI_ASSISTED",
            "UNKNOWN"
          ],
          "title": "Ai Assistance Type",
          "type": "string"
        },
        "parent_sample_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Sample Id"
        },
        "code_path": {
          "title": "Code Path",
          "type": "string"
        },
        "language": {
          "enum": [
            "python",
            "java"
          ],
          "title": "Language",
          "type": "string"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "syntax_status": {
          "enum": [
            "PASSED",
            "FAILED",
            "NOT_RUN"
          ],
          "title": "Syntax Status",
          "type": "string"
        },
        "functional_check_status": {
          "enum": [
            "PASSED",
            "FAILED",
            "NOT_RUN"
          ],
          "title": "Functional Check Status",
          "type": "string"
        },
        "functional_check_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Functional Check Evidence"
        },
        "raw_output_ref": {
          "title": "Raw Output Ref",
          "type": "string"
        },
        "license_or_authorization_ref": {
          "title": "License Or Authorization Ref",
          "type": "string"
        },
        "redistribution_allowed": {
          "title": "Redistribution Allowed",
          "type": "boolean"
        },
        "privacy_status": {
          "enum": [
            "PUBLIC_AUTHORIZED",
            "LOCAL_RESTRICTED",
            "SYNTHETIC"
          ],
          "title": "Privacy Status",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "split": {
          "enum": [
            "validation",
            "test"
          ],
          "title": "Split",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "problem_id",
        "source_family_id",
        "generation_session_id",
        "origin_type",
        "ai_assistance_type",
        "parent_sample_id",
        "code_path",
        "language",
        "code_sha256",
        "syntax_status",
        "functional_check_status",
        "functional_check_evidence",
        "raw_output_ref",
        "license_or_authorization_ref",
        "redistribution_allowed",
        "privacy_status",
        "synthetic",
        "split"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "GenerationSession": {
      "additionalProperties": false,
      "properties": {
        "generation_session_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Generation Session Id",
          "type": "string"
        },
        "problem_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Problem Id",
          "type": "string"
        },
        "source_family_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Source Family Id",
          "type": "string"
        },
        "session_independence_basis": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Session Independence Basis",
          "type": "string"
        },
        "provider": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Provider",
          "type": "string"
        },
        "model_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Model Id",
          "type": "string"
        },
        "model_version_or_snapshot": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Model Version Or Snapshot",
          "type": "string"
        },
        "access_mode": {
          "enum": [
            "MANUAL_EXPORT",
            "AUTHORIZED_API_EXPORT",
            "SYNTHETIC_FIXTURE"
          ],
          "title": "Access Mode",
          "type": "string"
        },
        "generation_time_utc": {
          "title": "Generation Time Utc",
          "type": "string"
        },
        "prompt_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_family": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Prompt Family",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "full_prompt_storage_ref": {
          "title": "Full Prompt Storage Ref",
          "type": "string"
        },
        "session_record_ref": {
          "title": "Session Record Ref",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Top P"
        },
        "seed_if_supported": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Seed If Supported"
        },
        "settings_semantics": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Settings Semantics",
          "type": "string"
        },
        "revision_count": {
          "minimum": 0,
          "title": "Revision Count",
          "type": "integer"
        },
        "human_edits": {
          "title": "Human Edits",
          "type": "boolean"
        },
        "shared_upstream_refs": {
          "items": {
            "type": "string"
          },
          "title": "Shared Upstream Refs",
          "type": "array"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "attempt_status": {
          "default": "UNKNOWN",
          "enum": [
            "COMPLETED",
            "FAILED",
            "TRUNCATED",
            "UNKNOWN"
          ],
          "title": "Attempt Status",
          "type": "string"
        },
        "error_or_truncation_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Or Truncation Ref"
        }
      },
      "required": [
        "generation_session_id",
        "problem_id",
        "source_family_id",
        "session_independence_basis",
        "provider",
        "model_id",
        "model_version_or_snapshot",
        "access_mode",
        "generation_time_utc",
        "prompt_id",
        "prompt_family",
        "prompt_sha256",
        "full_prompt_storage_ref",
        "session_record_ref",
        "temperature",
        "top_p",
        "seed_if_supported",
        "settings_semantics",
        "revision_count",
        "human_edits",
        "shared_upstream_refs",
        "synthetic"
      ],
      "title": "GenerationSession",
      "type": "object"
    },
    "PairRelation": {
      "additionalProperties": false,
      "properties": {
        "sample_a": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Sample A",
          "type": "string"
        },
        "sample_b": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Sample B",
          "type": "string"
        },
        "claimed_relation": {
          "enum": [
            "HUMAN_INDEPENDENT",
            "AI_INDEPENDENT_SAME_MODEL",
            "AI_INDEPENDENT_CROSS_MODEL",
            "KNOWN_DERIVED_HUMAN",
            "KNOWN_DERIVED_AI_REWRITE",
            "UNCERTAIN"
          ],
          "title": "Claimed Relation",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "NOT_REVIEWED",
            "CONFLICT",
            "AGREED"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "reviewer_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Reviewer Ids",
          "type": "array"
        },
        "reviewer_types": {
          "items": {
            "enum": [
              "HUMAN",
              "AI",
              "UNSPECIFIED"
            ],
            "type": "string"
          },
          "title": "Reviewer Types",
          "type": "array"
        },
        "reviewer_independence_confirmed": {
          "title": "Reviewer Independence Confirmed",
          "type": "boolean"
        },
        "reviewed_code_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Reviewed Code Sha256",
          "type": "array"
        },
        "label_evidence_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label Evidence Ref"
        },
        "independence_evidence_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Independence Evidence Ref"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reviewed At"
        },
        "template_only_shared_upstream_confirmed": {
          "title": "Template Only Shared Upstream Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "sample_a",
        "sample_b",
        "claimed_relation",
        "review_status",
        "reviewer_ids",
        "reviewer_types",
        "reviewer_independence_confirmed",
        "reviewed_code_sha256",
        "label_evidence_ref",
        "independence_evidence_ref",
        "reviewed_at",
        "template_only_shared_upstream_confirmed"
      ],
      "title": "PairRelation",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "UNREGISTERED",
            "FROZEN"
          ],
          "title": "Status",
          "type": "string"
        },
        "registered_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Registered At"
        },
        "plan_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Plan Ref"
        },
        "config_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Config Sha256"
        },
        "split_preregistered": {
          "title": "Split Preregistered",
          "type": "boolean"
        },
        "user_study_consent_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "User Study Consent Ref"
        }
      },
      "required": [
        "status",
        "registered_at",
        "plan_ref",
        "config_sha256",
        "split_preregistered",
        "user_study_consent_ref"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "problem_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Problem Id",
          "type": "string"
        },
        "problem_family": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Problem Family",
          "type": "string"
        },
        "language": {
          "enum": [
            "python",
            "java"
          ],
          "title": "Language",
          "type": "string"
        },
        "title": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "question_path": {
          "title": "Question Path",
          "type": "string"
        },
        "question_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Question Text Sha256",
          "type": "string"
        },
        "difficulty_proxy": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ],
          "title": "Difficulty Proxy",
          "type": "string"
        },
        "solution_space_proxy": {
          "enum": [
            "NARROW",
            "BROAD",
            "UNKNOWN"
          ],
          "title": "Solution Space Proxy",
          "type": "string"
        },
        "template_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Template Id"
        },
        "template_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Template Path"
        },
        "hidden_test_policy": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Hidden Test Policy",
          "type": "string"
        },
        "course_ai_policy": {
          "enum": [
            "ALLOWED",
            "PROHIBITED",
            "UNKNOWN"
          ],
          "title": "Course Ai Policy",
          "type": "string"
        },
        "confidentiality": {
          "enum": [
            "PUBLIC",
            "LOCAL_RESTRICTED",
            "SYNTHETIC"
          ],
          "title": "Confidentiality",
          "type": "string"
        },
        "license_or_authorization_ref": {
          "title": "License Or Authorization Ref",
          "type": "string"
        },
        "split": {
          "enum": [
            "validation",
            "test"
          ],
          "title": "Split",
          "type": "string"
        }
      },
      "required": [
        "problem_id",
        "problem_family",
        "language",
        "title",
        "question_path",
        "question_text_sha256",
        "difficulty_proxy",
        "solution_space_proxy",
        "template_id",
        "template_path",
        "hidden_test_policy",
        "course_ai_policy",
        "confidentiality",
        "license_or_authorization_ref",
        "split"
      ],
      "title": "Question",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "ai-convergence-1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "dataset_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Dataset Version",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/Question"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Questions",
      "type": "array"
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/GenerationSession"
      },
      "maxItems": 1000,
      "title": "Sessions",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Artifacts",
      "type": "array"
    },
    "pair_relations": {
      "items": {
        "$ref": "#/$defs/PairRelation"
      },
      "maxItems": 10000,
      "title": "Pair Relations",
      "type": "array"
    }
  },
  "required": [
    "protocol_version",
    "dataset_version",
    "provenance",
    "questions",
    "sessions",
    "artifacts",
    "pair_relations"
  ],
  "title": "Corpus",
  "type": "object"
}
