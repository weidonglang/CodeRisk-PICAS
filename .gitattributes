* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.java text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.md text eol=lf
# Frozen experiment evidence retains the exact bytes used by its checksums.
coderisk/experiment/evidence/** -text whitespace=cr-at-eol
# Matplotlib SVG path data intentionally contains line-ending spaces.
coderisk/experiment/evidence/**/*.svg -whitespace
# External-tool logs preserve progress output verbatim.
coderisk/experiment/evidence/**/native/**/*.txt -whitespace
coderisk/configs/experiments/*.json text eol=lf
coderisk/experiment/public_dataset_sources.json text eol=lf
